API_ID=123456
API_HASH=your_api_hash_here
PHONE=+10000000000
SESSION_NAME=easy_seen

# Secret unlock phrase for auto_reply admin mode (prefer env over modules.json)
ADMIN_PASSWORD=change_me

# Permanent admins that survive a restart with an empty data/ dir
# ADMIN_IDS=733089022

# Multi-account (GitHub Actions sets these per workflow)
# ACCOUNT_ID=elmira
# DATA_DIR=data/elmira
# Local/dev: leave ACCOUNT_ID unset and use SESSION_NAME=dev_seen

# Optional overrides
# LOG_LEVEL=INFO
# LOCK_FILE=telegram_auto.lock
# MAX_RUNTIME_SECONDS=21300
# FLOOD_SLEEP_THRESHOLD=120
