API_ID=123456
API_HASH=your_api_hash_here
PHONE=+10000000000
SESSION_NAME=easy_seen

# Secret unlock phrase for auto_reply admin mode (prefer env over modules.json)
ADMIN_PASSWORD=change_me

# Permanent admins that survive a restart with an empty data/ dir
# ADMIN_IDS=733089022

# Multi-account (GitHub Actions sets these per workflow)
# ACCOUNT_ID=elmira
# DATA_DIR=data/elmira
# Local/dev: leave ACCOUNT_ID unset and use SESSION_NAME=dev_seen

# Cloudflare Workers AI (optional seed file — never commit secrets)
# CLOUDFLARE_AI_SEED_FILE=D:/path/to/config.yaml
# Seed: python scripts/seed_cloudflare_ai.py --file %CLOUDFLARE_AI_SEED_FILE%
# On CI the AI accounts are pulled from the admin-bot bridge instead
# (GET /internal/cfai/export) using ADMIN_BOT_BRIDGE_URL/ADMIN_BOT_BRIDGE_TOKEN.

# Optional web search for the linkdir query agent (keyless DuckDuckGo if unset)
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=

# Optional overrides
# LOG_LEVEL=INFO
# LOCK_FILE=telegram_auto.lock
# MAX_RUNTIME_SECONDS=21300
# FLOOD_SLEEP_THRESHOLD=120
